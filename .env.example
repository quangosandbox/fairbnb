DATABASE_URL="postgresql://fairbnb:fairbnb@localhost:5432/fairbnb"
# Neon: DATABASE_URL is the pooled string, DATABASE_URL_UNPOOLED the direct one (`neon env pull` writes both).
# Locally both can point at the same database.
DATABASE_URL_UNPOOLED="postgresql://fairbnb:fairbnb@localhost:5432/fairbnb"
SESSION_SECRET="dev-only-secret-change-me-0123456789abcdef"
# Leave blank to run payments in mock mode
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Email (optional). Without RESEND_API_KEY, emails are logged (and written to EMAIL_OUTBOX_DIR if set).
RESEND_API_KEY=""
EMAIL_FROM="Fairbnb <hello@yourdomain.com>"
EMAIL_OUTBOX_DIR=""
# Error tracking (optional): create a Next.js project at sentry.io and paste its DSN into both.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Optional, for readable stack traces (source map upload at build time)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# Vercel Cron authenticates with this
CRON_SECRET=""
